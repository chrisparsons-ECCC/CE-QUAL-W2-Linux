# Keep the initial repository source-only. The publication preflight provides
# the stricter exact-file allowlist; ignore rules are not a secret scan.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/VERSION
!/LICENSE*
!/NOTICE*
!/source/
!/config/
!/cases/
!/tools/
!/tests/
!/docs/
!/provenance/
!/notices/
# Never stage generated payloads or credentials from approved trees.
**/__pycache__/
**/.pytest_cache/
*.pyc
*.pyo
*.o
*.obj
*.mod
*.smod
*.a
*.lib
*.so
*.so.*
*.dll
*.exe
*.pdb
*.zip
*.tar
*.tar.*
*.gz
*.xz
*.log
*.stdout
*.stderr
*.core
core
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.kdbx
**/.git/
**/build/
**/builds/
**/runs/
**/outputs/
**/runtime/
**/intel/
**/oneapi/
